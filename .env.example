# ==============================================================================
# RASHX Platform HQ - Environment Variables Template
# ==============================================================================
# Copy this file to .env.local for local development.
# In production (e.g. Vercel), configure these in Project Settings > Environment Variables.
# DO NOT commit real secrets, private keys, or passwords to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Admin SDK (Server-Side Only - Platform HQ Dashboard)
# ------------------------------------------------------------------------------
# Service Account credentials for server-only Firestore & Session Management.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Private key with newlines formatted as \n (e.g. "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n")
FIREBASE_PRIVATE_KEY=""

# ------------------------------------------------------------------------------
# 2. Firebase Client SDK (Client-Side Only - Login Page Authentication)
# ------------------------------------------------------------------------------
# Used exclusively to authenticate via email/password and obtain an ID token.
# The client SDK never talks to Firestore directly.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""

# ------------------------------------------------------------------------------
# 3. Analytics & Marketing Pixels (Optional)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_GSC_VERIFICATION=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_SNAP_PIXEL_ID=""
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""

# ------------------------------------------------------------------------------
# 4. SMTP Email Configuration (Nodemailer)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

