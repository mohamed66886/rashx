# ==============================================================================
# RASHX Platform HQ - Environment Variables Template
# ==============================================================================
# Copy this file to .env.local for local development.
# In production (e.g. Vercel), configure these in Project Settings > Environment Variables.
# DO NOT commit real secrets, private keys, or passwords to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Site & App URLs
# ------------------------------------------------------------------------------
# Base URL of the platform. Used to construct invoice signing links, verification URLs, and email CTAs.
# Local development: http://localhost:3000 | Production: https://admin.rashx.org
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. Firebase Admin SDK (Server-Side Only - Platform HQ Dashboard)
# ------------------------------------------------------------------------------
# Service Account credentials for server-only Firestore & Session Management.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Private key with newlines formatted as \n (e.g. "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n")
FIREBASE_PRIVATE_KEY=""
# Optional: force Firestore Admin to use REST over HTTPS when gRPC DNS resolution fails (fixes 14 UNAVAILABLE error).
FIRESTORE_PREFER_REST=true

# ------------------------------------------------------------------------------
# 3. Firebase Client SDK (Client-Side Only - Login Page Authentication)
# ------------------------------------------------------------------------------
# Used exclusively to authenticate via email/password and obtain an ID token.
# The client SDK never talks to Firestore directly.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""

# ------------------------------------------------------------------------------
# 4. SMTP Email Configuration (Nodemailer)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# ------------------------------------------------------------------------------
# 5. Billing & Notifications
# ------------------------------------------------------------------------------
# Target email to receive notifications when a client uploads a signed contract/invoice.
# Defaults to SMTP_USER if not set.
BILLING_NOTIFY_EMAIL=""

# ------------------------------------------------------------------------------
# 6. Background Jobs & Security
# ------------------------------------------------------------------------------
# Secret token required to authenticate Vercel Cron or external curl triggers (Bearer ${CRON_SECRET})
# Example: generate with `openssl rand -hex 32`
CRON_SECRET=""

# ------------------------------------------------------------------------------
# 7. Analytics & Marketing Pixels (Optional)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_GSC_VERIFICATION=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_SNAP_PIXEL_ID=""
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""
